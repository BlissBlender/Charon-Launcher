{
  "name": "charon-launcher",
  "private": true,
  "version": "1.0.0",
  "description": "High-Performance Next-Gen Game Launcher with In-App Differential Updates",
  "author": "Charon Technologies",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlissBlender/Charon-Launcher.git"
  },
  "build": {
    "appId": "com.charon.gamelauncher",
    "productName": "Charon Game Launcher",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "sources/**/*",
      "main.js",
      "preload.js",
      "aria2c.exe",
      "7z.exe",
      "7z.dll"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "BlissBlender",
        "repo": "Charon-Launcher"
      }
    ],
    "extraResources": [
      {
        "from": "aria2c.exe",
        "to": "aria2c.exe"
      },
      {
        "from": "7z.exe",
        "to": "7z.exe"
      },
      {
        "from": "7z.dll",
        "to": "7z.dll"
      },
      {
        "from": "sources",
        "to": "sources"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Charon Game Launcher",
      "differentialPackage": true
    }
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "howlongtobeat": "^1.8.0",
    "lucide-react": "^0.439.0",
    "puppeteer": "^25.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.0.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1",
    "wait-on": "^8.0.0"
  }
}
